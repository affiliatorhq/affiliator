// ══════════════════════════════════════════
function tick(){
  const n=new Date(),e=new Date(n);e.setHours(23,59,59,0);
  const d=e-n,h=Math.floor(d/3600000),m=Math.floor((d%3600000)/60000),s=Math.floor((d%60000)/1000);
  ["","2"].forEach(sf=>{
    const eh=document.getElementById("dh"+sf),em=document.getElementById("dm"+sf),es=document.getElementById("ds"+sf);
    if(eh)eh.textContent=String(h).padStart(2,"0");
    if(em)em.textContent=String(m).padStart(2,"0");
    if(es)es.textContent=String(s).padStart(2,"0");
  });
}
tick();setInterval(tick,1000);

// ══════════════════════════════════════════
// HERO COUNTER ANIMATION
// ══════════════════════════════════════════
function cntTo(el,target){
  const dur=2000,st=performance.now();
  (function s(ts){const prog=Math.min((ts-st)/dur,1),ease=1-Math.pow(1-prog,3),v=Math.round(ease*target);el.textContent=v>=1000?(v/1000).toFixed(1)+"K+":v+"+";if(prog<1)requestAnimationFrame(s);})(performance.now());
}
