function doSearch(){
  const q=document.getElementById("sInp").value.trim().toLowerCase();if(!q)return;
  go("trending");
  const res=P.filter(p=>p.name.toLowerCase().includes(q)||p.cat.toLowerCase().includes(q)||p.desc.toLowerCase().includes(q));
  document.getElementById("tGrid").innerHTML=(res.length?res:P).map((p,i)=>cHTML(p,i*.035)).join("");
  document.getElementById("sInp").value="";
  setTimeout(obsR,80);
}
document.getElementById("sInp").addEventListener("keyup",e=>{if(e.key==="Enter")doSearch();});

