function nlSub(id,btn){
  const inp=document.getElementById(id);
  if(inp?.value){btn.textContent="✓ Subscribed!";btn.style.background="linear-gradient(135deg,#1e6b3e,#165530)";inp.value="";setTimeout(()=>{btn.textContent="Subscribe";btn.style.background="";},3000);}
}
